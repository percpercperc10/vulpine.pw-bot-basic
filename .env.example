# Token shown by the Vulpine.pw portal only when creating or resetting a bot.
VULPINE_BOT_TOKEN=vb_your_bot_token_here
# Used only by register_commands.py. Do not use the bot token here.
VULPINE_ACCOUNT_TOKEN=your_account_token_here
# Optional: register_commands.py can discover this from VULPINE_BOT_TOKEN.
# VULPINE_BOT_ID=your_bot_id
# Optional: alternate API address for testing.
VULPINE_API=https://vulpine.pw/api
LOG_LEVEL=INFO
COMMAND_COOLDOWN=1.0
BOT_DISPLAY_NAME=Vulpine Social
BOT_USERNAME=social_bot
